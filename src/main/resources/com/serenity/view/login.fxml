<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.serenity.controller.MainController">
    <left>
        <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #2c3e50; -fx-min-width: 160;">
            <Button text="Therapists" onAction="#loadTherapists" maxWidth="Infinity"/>
            <Button text="Patients" onAction="#loadPatients" maxWidth="Infinity"/>
            <Button text="Programs" onAction="#loadPrograms" maxWidth="Infinity"/>
            <Button text="Sessions" onAction="#loadSessions" maxWidth="Infinity"/>
            <Button text="Payments" onAction="#loadPayments" maxWidth="Infinity"/>
            <Button text="Change Password" onAction="#changePassword" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#logout" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>